# Generated by multi-git — SSH client configuration

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/{{.PersonalKey}}
    IdentitiesOnly yes
    AddKeysToAgent yes

Host vs-ssh.visualstudio.com
    HostName vs-ssh.visualstudio.com
    User git
    IdentityFile ~/.ssh/{{.CorporateKey}}
    IdentitiesOnly yes
    AddKeysToAgent yes

Host ssh.dev.azure.com
    HostName ssh.dev.azure.com
    User git
    IdentityFile ~/.ssh/{{.CorporateKey}}
    IdentitiesOnly yes
    AddKeysToAgent yes
