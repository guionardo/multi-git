# Generated by multi-git — global Git configuration

[init]
    defaultBranch = main

[core]
    # autocrlf = true (Windows) | input (Linux/macOS/WSL)

[pull]
    rebase = false

[fetch]
    prune = true

[user]
    name = {{.PersonalName}}
    email = {{.PersonalEmail}}

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

[includeIf "gitdir/i:~/personal/"]
    path = ~/.gitconfig-personal

[includeIf "gitdir/i:~/work/"]
    path = ~/.gitconfig-work
